APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ledger
DB_USER=ledger
DB_PASS=

# 32 random bytes, base64. Generate with:
#   php -r "echo base64_encode(random_bytes(32));"
JWT_SECRET=
JWT_ISSUER=ledger
# seconds
JWT_ACCESS_TTL=900
REFRESH_TTL_DAYS=30

# attempts allowed per window (seconds)
RATE_WINDOW=300
RATE_LOGIN_PER_IP=30
RATE_LOGIN_PER_EMAIL=5
RATE_WRITE_PER_USER=120
RATE_REGISTER_PER_IP=5

# one-time passwords and invite tokens expire after this many hours
INVITE_TTL_HOURS=72
