{
    "name": "ibexstone/ledger",
    "description": "Multi-tenant project cashbook. PKR only, amounts stored as integer paisa.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Ledger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ledger\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:js": "node --test tests/js/money.test.mjs",
        "lint": "phpcs --standard=PSR12 src tests public/index.php migrate.php seed.php"
    },
    "config": {
        "sort-packages": true
    }
}
